{
  "name": "ecu-app",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "description": "Interface touch da nossa ECU (base rusEFI), estilo profissional",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bridge": "tsx src/bridge/main.ts",
    "start": "vite build && tsx src/bridge/main.ts",
    "test": "vitest run",
    "bundle:bridge": "esbuild src/bridge/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=build/bridge.mjs --external:serialport --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "app": "npm run build && npm run bundle:bridge && electron .",
    "dist:mac": "npm run build && npm run bundle:bridge && electron-builder --mac dmg --x64",
    "dist:win": "npm run build && npm run bundle:bridge && electron-builder --win nsis --x64 -c.npmRebuild=false"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0",
    "ws": "^8.22.1"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "br.ciconato.ecu",
    "productName": "ECU",
    "files": [
      "dist/**",
      "ini/**",
      "build/bridge.mjs",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "artifactName": "ECU-${version}-mac-intel.${ext}"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ECU-${version}-windows-setup.${ext}",
      "shortcutName": "ECU"
    }
  }
}
